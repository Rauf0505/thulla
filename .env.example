# Long-lived hosts (Docker/VPS): session pooler (port 5432), or direct if the host has IPv6.
# Vercel/serverless: transaction pooler (port 6543) from Supabase → Connect.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

SUPABASE_URL=https://[PROJECT-REF].supabase.co
# Server-only. Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

ADMIN_BOOTSTRAP_EMAILS=owner@example.com

# Optional. Defaults to 1 on Vercel and 10 elsewhere.
# DB_MAX=1
